# Rust build
/target/
Cargo.lock

# Состояние узлов — identity-ключи НИКОГДА не в репозитории
state/
*/state/
# Экспериментальные результаты (сырые данные коммитятся отдельно)
experiments/results/*.csv
experiments/results/*.json
experiments/results/*.png
# Docker volumes
.docker-data/
# Editor
.vscode/
.idea/
*.swp
# Результаты экспериментов (сырые данные — в gitignore, только структура)
experiments/results/*/
metrics/*/
logs/
# Каталог логов узлов и скриптов

# Приёмочные прогоны (реальные данные коммитятся; ключи — никогда)
!experiments/results/accept_*/
!experiments/results/accept_*/**
experiments/results/accept_*/state/

# Сценарии 01–09 и контрольный pcap (ТЗ §19: сырые данные и pcap без секретных ключей сдаются)
!experiments/results/0*/
!experiments/results/0*/**
!experiments/results/pcap_no_plaintext/
!experiments/results/pcap_no_plaintext/**

# Python
__pycache__/
